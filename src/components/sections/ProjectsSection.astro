---
import { SECTION } from "@/lib/constants";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { buildImageUrl } from "@/lib/utils";

const allProjects = await getCollection("projects").then((c) =>
  c.map((p) => p.data),
);
---

<section id={SECTION.PROJECTS} class="min-h-dvh space-y-20 py-20 px-4 md:px-6">
  <header>
    <span class="uppercase text-sm block mb-4">01 / proyectos</span>
    <h2
      class="text-3xl md:text-5xl lg:text-7xl font-bold uppercase tracking-tighter"
    >
      Casos de estudio
    </h2>
  </header>
  <div class="space-y-32">
    {
      allProjects.map((project) => (
        <article>
          <h3>{project.title}</h3>
          <p>
            {buildImageUrl({
              name: "hero",
              ext: project.images.hero.ext,
              branch: "main",
              project: project.projectName,
            })}
          </p>
          <Image
            src={buildImageUrl({
              name: "hero",
              ext: project.images.hero.ext,
              branch: "main",
              project: project.projectName,
            })}
            alt={project.images.hero.alt}
            width={1080}
            height={720}
          />
        </article>
      ))
    }
  </div>
  <div class="flex justify-end">
    <a href="/projects" class="hover:underline">Ver Todos los Proyectos...</a>
  </div>
</section>
