---
import { SECTION } from "@/lib/constants";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { buildImageUrl } from "@/lib/utils";

const allProjects = await getCollection("projects").then((c) =>
  c.map((p) => p.data).sort((a, b) => a.priority - b.priority),
);
---

<section id={SECTION.PROJECTS} class="min-h-dvh space-y-20 py-20">
  <header>
    <span class="uppercase text-sm block mb-4 text-tertiary"
      >01 / proyectos</span
    >
    <h2
      class="text-3xl md:text-5xl lg:text-7xl font-bold uppercase tracking-tighter"
    >
      Casos de estudio
    </h2>
  </header>

  <div class="space-y-24 md:space-y-32">
    {
      allProjects.map((project, index) => {
        const isEven = index % 2 === 1;
        const imageUrl = buildImageUrl({
          name: "hero",
          ext: project.images.hero.ext,
          branch: "main",
          project: project.slug,
        });

        return (
          <article class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-stretch group">
            {/* Imagen */}
            <div class={`order-1 ${isEven ? "md:order-2" : "md:order-1"}`}>
              <a
                href={`/projects/${project.slug}`}
                class="block overflow-hidden border border-primary/20"
              >
                <Image
                  src={imageUrl}
                  alt={project.images.hero.alt}
                  width={1080}
                  height={720}
                  class="w-full h-auto aspect-video object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </a>
            </div>

            {/* Contenido */}
            <div
              class={`order-2 ${isEven ? "md:order-1" : "md:order-2"} flex flex-col justify-between py-1`}
            >
              <div class="space-y-6">
                <div class="space-y-2">
                  <span class="text-xs uppercase tracking-widest text-accent font-semibold">
                    {project.category}
                  </span>
                  <h3 class="text-2xl md:text-4xl font-bold uppercase tracking-tighter">
                    <a
                      href={`/projects/${project.slug}`}
                      class="hover:text-accent transition-colors"
                    >
                      {project.title}
                    </a>
                  </h3>
                </div>

                <p class="text-tertiary text-base md:text-lg leading-relaxed">
                  {project.summary}
                </p>

                <div class="flex flex-wrap gap-2">
                  {project.stack.slice(0, 6).map((tech) => (
                    <span class="px-3 py-1 text-xs uppercase font-medium border border-primary/30 text-primary">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="pt-6">
                <a
                  href={project.links.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm uppercase font-semibold hover:text-accent transition-colors"
                >
                  Ver repositorio
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="flex justify-end pt-8">
    <a
      href="https://github.com/Criss117"
      target="_blank"
      rel="noopener noreferrer"
      class="hover-btn hover-btn--accent py-4 px-8 border border-accent uppercase font-semibold text-sm text-center inline-block"
    >
      Ver Todos los Proyectos...
    </a>
  </div>
</section>
