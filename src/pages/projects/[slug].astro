---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { buildImageUrl } from "@/lib/utils";
import { SOCIAL } from "@/lib/constants";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;

const heroUrl = buildImageUrl({
  project: data.projectName,
  name: "hero",
  ext: data.images.hero.ext,
  branch: "main",
});

const coverUrl = buildImageUrl({
  project: data.projectName,
  name: "cover",
  ext: data.images.cover.ext,
  branch: "main",
});

const galleryUrls = data.images.gallery.map((img) => ({
  ...img,
  url: buildImageUrl({
    project: data.projectName,
    name: img.name,
    ext: img.ext,
    branch: "main",
  }),
}));
---

<Layout>
  <main class="overflow-x-hidden">
    {/* ═══════════════════════════════════════════════════════ */}
    {/*  HERO                                                 */}
    {/* ═══════════════════════════════════════════════════════ */}
    <section
      class="min-h-[70dvh] flex flex-col justify-end gap-y-8 pb-12 pt-32 px-4 md:px-6 lg:px-8"
    >
      <div class="max-w-full xl:max-w-3/4 mx-auto w-full space-y-8">
        <div class="space-y-4">
          <span
            class="text-xs uppercase tracking-widest text-accent font-semibold"
          >
            {data.category}
          </span>
          <h1
            class="text-4xl md:text-6xl lg:text-8xl font-bold uppercase tracking-tighter leading-[0.9]"
          >
            {data.title}
          </h1>
          <p
            class="text-tertiary text-base md:text-lg lg:text-xl max-w-2xl leading-relaxed"
          >
            {data.summary}
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          {
            data.stack
              .slice(0, 8)
              .map((tech) => (
                <span class="px-3 py-1 text-xs uppercase font-medium border border-primary/30 text-primary">
                  {tech}
                </span>
              ))
          }
        </div>

        <div class="flex gap-x-5 pt-2">
          {
            data.links.repo && (
              <a
                href={data.links.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="hover-btn hover-btn--accent py-4 px-8 border border-accent uppercase font-semibold text-center"
              >
                Ver repositorio
              </a>
            )
          }
          {
            data.links.demo && (
              <a
                href={data.links.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="hover-btn hover-btn--white py-4 px-8 border border-primary uppercase font-semibold text-center"
              >
                Demo en vivo
              </a>
            )
          }
        </div>
      </div>
    </section>

    {/* Hero image */}
    <section class="px-4 md:px-6 lg:px-8 pb-12">
      <div class="max-w-full xl:max-w-3/4 mx-auto">
        <div class="overflow-hidden border border-primary/20">
          <Image
            src={heroUrl}
            alt={data.images.hero.alt}
            width={1440}
            height={810}
            class="w-full h-auto aspect-video object-cover"
          />
        </div>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════ */}
    {/*  GALERÍA                                              */}
    {/* ═══════════════════════════════════════════════════════ */}
    {
      galleryUrls.length > 0 && (
        <section class="px-4 md:px-6 lg:px-8 py-20">
          <div class="max-w-full xl:max-w-3/4 mx-auto space-y-8">
            <span class="text-xs uppercase tracking-widest text-accent font-semibold block">
              Galería
            </span>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {galleryUrls.map((img) => (
                <figure class="overflow-hidden border border-primary/20 group">
                  <Image
                    src={img.url}
                    alt={img.alt}
                    width={720}
                    height={480}
                    class="w-full h-auto aspect-video object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  {img.caption && (
                    <figcaption class="px-4 py-3 text-xs text-tertiary border-t border-primary/10">
                      {img.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* ═══════════════════════════════════════════════════════ */}
    {/*  BODY MDX — Secciones estructuradas por el agente     */}
    {/* ═══════════════════════════════════════════════════════ */}
    <div class="px-4 md:px-6 lg:px-8">
      <Content />
    </div>

    {/* ═══════════════════════════════════════════════════════ */}
    {/*  CTA / DISPONIBILIDAD                                */}
    {/* ═══════════════════════════════════════════════════════ */}
    <section
      class="-mx-4 md:-mx-6 lg:-mx-8 px-4 md:px-6 lg:px-8 py-16 md:py-24 bg-primary dark:bg-[oklch(10%_0.005_250)]"
    >
      <div
        class="max-w-full xl:max-w-3/4 mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center"
      >
        <div class="space-y-6">
          <span
            class="text-[10px] uppercase tracking-widest text-accent font-semibold block"
          >
            Disponibilidad para proyectos críticos
          </span>
          <h2
            class="text-2xl md:text-4xl font-bold uppercase tracking-tighter leading-tight text-secondary dark:text-primary"
          >
            ¿Tienes un desafío similar de arquitectura, concurrencia o escala
            transaccional?
          </h2>
          <p
            class="text-tertiary text-base md:text-lg leading-relaxed max-w-xl"
          >
            Hablemos sobre diseño de sistemas distribuidos, optimización de
            pipelines o desarrollo integral de plataformas web con React Native
            y Elysia.
          </p>
        </div>
        <div
          class="flex flex-col sm:flex-row md:flex-col lg:flex-row items-start md:items-end lg:items-center gap-6 md:gap-8"
        >
          <a
            href={`mailto:${SOCIAL.EMAIL}?subject=Charla técnica`}
            class="hover-btn hover-btn--accent py-4 px-8 border border-accent uppercase font-semibold text-center bg-accent text-white"
          >
            Agendar charla técnica
          </a>
          <a
            href={`mailto:${SOCIAL.EMAIL}`}
            class="text-tertiary text-sm hover:text-accent transition-colors"
          >
            {SOCIAL.EMAIL}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
